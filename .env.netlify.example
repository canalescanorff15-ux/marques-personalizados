# Merlin Encantos em Papel — exemplo para importar no Netlify
# NÃO preencha este arquivo com segredos reais e NÃO faça commit de uma cópia preenchida.

# Público
NEXT_PUBLIC_SITE_NAME=Merlin Encantos em Papel
NEXT_PUBLIC_SITE_URL=https://SEU-SITE.netlify.app
NEXT_PUBLIC_LOCATION=Santa Inês - MA
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=55DDDNUMERO
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Neon
DATABASE_URL=

# Admin / segurança
SESSION_SECRET=
PRIVACY_HASH_SECRET=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
BACKUP_SIGNING_SECRET=
BACKUP_SIGNING_KEY_ID=primary
BACKUP_ENCRYPTION_SECRET=
BACKUP_ENCRYPTION_KEY_ID=primary

# Cloudflare R2 — bucket público de mídia
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=merlin-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://PUBLIC_BUCKET_OR_CUSTOM_DOMAIN
S3_REQUIRED=1

# Release
APP_RELEASE_ID=
APP_RELEASE_COMMIT=
# COMMIT_REF é fornecida automaticamente pelo Netlify e serve como fallback; não crie manualmente.
COMMIT_REF=
APP_DEPLOYED_AT=

# Backups: podem continuar no GitHub Actions. Se ativar R2 offsite, use bucket PRIVADO separado.
BACKUP_OFFSITE_ENABLED=0
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=merlin-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=merlin-backups
BACKUP_S3_FORCE_PATH_STYLE=1
BACKUP_OFFSITE_RETENTION_DAYS=45
BACKUP_OFFSITE_MAX_AGE_HOURS=36
